# Required. https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Signed session cookies. At least 32 characters.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Postgres URI. Supabase: dashboard Connect button → Transaction pooler (port 6543).
# POSTGRES_URL is also accepted. The users table is created on first use.
# Percent-encode special characters in the password (@ $ # * become %40 %24 %23 %2A).
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Invite code required to create an account. Anyone who has this can register;
# anyone who does not cannot. Rotate it if it leaks.
LECTERN_ADMIN_CODE=

# Model used for passage selection and the pastoral response. This is the step
# where theological judgment happens, so it gets the strongest model.
# Any OpenRouter slug that supports forced tool calls will work.
LECTERN_MODEL_SELECT=anthropic/claude-opus-5

# Model used for query expansion. A cheap, fast step.
LECTERN_MODEL_EXPAND=anthropic/claude-haiku-4.5

# Optional. Sent to OpenRouter for attribution in its activity dashboard.
LECTERN_PUBLIC_URL=http://localhost:3000

# Embedding provider for dense retrieval: "transformers" | "voyage" | "openai" | "none".
# Retrieval degrades to lexical-only BM25 when set to "none" or when no vectors
# have been built, so the app remains functional without this.
# Note that "transformers" runs locally and needs no key or network at request time.
LECTERN_EMBEDDING_PROVIDER=transformers

# Only needed when LECTERN_EMBEDDING_PROVIDER is "voyage" or "openai". These are
# direct vendor keys, not OpenRouter ones — OpenRouter does not proxy embeddings.
VOYAGE_API_KEY=
OPENAI_API_KEY=
